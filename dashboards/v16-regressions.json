{
  "uid": "cae-v15-regressions",
  "annotations": [
    {
      "kind": "AnnotationQuery",
      "spec": {
        "builtIn": true,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "query": {
          "datasource": {
            "name": "-- Grafana --"
          },
          "group": "grafana",
          "kind": "DataQuery",
          "spec": {},
          "version": "v0"
        }
      }
    }
  ],
  "cursorSync": "Off",
  "description": "Fleet-wide regression triage: how many tests are slower than they used to be, anywhere, and whether every repository is still reporting. No repository filter on purpose - for one repo's health and per-test drilldown use the Repo Health dashboard (linked in the top bar and from every test name).",
  "editable": true,
  "elements": {
    "panel-1": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "${datasource}"
                    },
                    "group": "prometheus",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "exemplar": false,
                      "expr": "count(\n  (\n      max by (test_id, vcs_repository_name, server_version) (\n        quantile_over_time(0.5, cae_v16_test_duration_seconds{server_version=~\"$server_version\", vcs_repository_ref_name=~\"$branch\"}[$recent])\n      )\n    /\n      clamp_min(\n        max by (test_id, vcs_repository_name, server_version) (\n          quantile_over_time(0.5, cae_v16_test_duration_seconds{server_version=~\"$server_version\", vcs_repository_ref_name=~\"$branch\"}[$baseline] offset $recent)\n        ),\n        0.05\n      )\n  ) > $ratio\n  and\n  (\n      max by (test_id, vcs_repository_name, server_version) (\n        quantile_over_time(0.5, cae_v16_test_duration_seconds{server_version=~\"$server_version\", vcs_repository_ref_name=~\"$branch\"}[$recent])\n      )\n    -\n      max by (test_id, vcs_repository_name, server_version) (\n        quantile_over_time(0.5, cae_v16_test_duration_seconds{server_version=~\"$server_version\", vcs_repository_ref_name=~\"$branch\"}[$baseline] offset $recent)\n      )\n  ) > 1\n  and\n    max by (test_id, vcs_repository_name, server_version) (\n      count_over_time(cae_v16_test_duration_seconds{server_version=~\"$server_version\", vcs_repository_ref_name=~\"$branch\"}[$baseline] offset $recent)\n    ) >= 10\n)\nor vector(0)",
                      "format": "time_series",
                      "instant": true,
                      "legendFormat": "regressed",
                      "range": false
                    },
                    "version": "v0"
                  },
                  "refId": "regressed_count"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "How many tests across ALL repositories are slower right now than they used to be. A test counts only if all three are true: more than the chosen threshold slower than its usual duration, at least 1 second of real slowdown, and 10+ past measurements. 0 means everything is running at its normal speed.",
        "id": 1,
        "links": [],
        "title": "Regressed tests now",
        "vizConfig": {
          "group": "stat",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "thresholds"
                },
                "mappings": [],
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": 0
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                },
                "unit": "short"
              },
              "overrides": []
            },
            "options": {
              "colorMode": "value",
              "graphMode": "none",
              "justifyMode": "auto",
              "orientation": "auto",
              "reduceOptions": {
                "calcs": ["lastNotNull"],
                "fields": "",
                "values": false
              },
              "showPercentChange": false,
              "textMode": "auto",
              "wideLayout": true
            }
          },
          "version": "13.2.0-29854286369"
        }
      }
    },
