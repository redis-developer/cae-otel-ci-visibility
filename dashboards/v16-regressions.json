          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "${datasource}"
                    },
                    "group": "prometheus",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "code",
                      "exemplar": false,
                      "expr": "(\n    max by (test_id, vcs_repository_name, server_version) (\n      quantile_over_time(0.5, cae_v16_test_duration_seconds{vcs_repository_ref_name=~\"$branch\"}[$recent])\n    )\n  /\n    clamp_min(\n      max by (test_id, vcs_repository_name, server_version) (\n        quantile_over_time(0.5, cae_v16_test_duration_seconds{vcs_repository_ref_name=~\"$branch\"}[$baseline] offset $recent)\n      ),\n      0.05\n    )\n) > $ratio\nand\n(\n    max by (test_id, vcs_repository_name, server_version) (\n      quantile_over_time(0.5, cae_v16_test_duration_seconds{vcs_repository_ref_name=~\"$branch\"}[$recent])\n    )\n  -\n    max by (test_id, vcs_repository_name, server_version) (\n      quantile_over_time(0.5, cae_v16_test_duration_seconds{vcs_repository_ref_name=~\"$branch\"}[$baseline] offset $recent)\n    )\n) > 1\nand\n  max by (test_id, vcs_repository_name, server_version) (\n    count_over_time(cae_v16_test_duration_seconds{vcs_repository_ref_name=~\"$branch\"}[$baseline] offset $recent)\n  ) >= 10",
                      "format": "table",
                      "instant": true,
                      "legendFormat": "__auto",
                      "range": false
                    },
                    "version": "v0"
                  },
                  "refId": "regressed"
